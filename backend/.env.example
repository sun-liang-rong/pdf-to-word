# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3456

# Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=pdf_converter
DATABASE_PASSWORD=change_me
DATABASE_NAME=pdf_converter
TYPEORM_SYNCHRONIZE=false

# Stirling-PDF
STIRLING_PDF_URL=http://127.0.0.1:8080
STIRLING_PDF_TIMEOUT=120000
STIRLING_PDF_API_KEY=
OCR_LANGUAGES=chi_sim+eng

# Files and limits
UPLOAD_DIR=./uploads
FILE_EXPIRE_MINUTES=30
MAX_FILE_SIZE=20971520
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=86400000
